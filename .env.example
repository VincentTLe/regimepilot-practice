# Copy this file to .env and fill it in yourself, locally.
# .env is git-ignored. Never commit real keys and never paste them into a chat.
#
# Paper keys come from: https://app.alpaca.markets/paper/dashboard/overview

ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Paper trading only. This project refuses to start if this is not true.
ALPACA_PAPER=true

# Optional for Phase 3 live LLM decisions via OpenRouter (Ox Alpha).
# Not required when running: python -m regimepilot.decision --stub
# Get a key from: https://openrouter.ai/
OPENROUTER_API_KEY=