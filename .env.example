# Alpaca PAPER trading keys — https://app.alpaca.markets/paper/dashboard/overview
# Never put live keys here. This project refuses to run against live trading.
ALPACA_API_KEY=PK...your-paper-key...
ALPACA_SECRET_KEY=...your-paper-secret...

# Must stay "true". Any other value aborts startup (paper-only project).
ALPACA_PAPER=true

# Strategy settings (whitelist, timeframe, risk, exits, ...) do NOT live here —
# they live in settings.yaml, the one file a trader edits.

# Optional: only needed for LLM decisions — https://featherless.ai/ (OpenAI-compatible API;
# endpoint and models are in settings.yaml `llm`). Leave blank and run with --manual-mode.
FEATHERLESS_API_KEY=

# Dashboard export (cli.py run --loop --dashboard). The Alpaca CLI profile that holds
# THIS paper account's keys (`alpaca profile login`), used to read clock/account/positions.
ALPACA_CLI_PROFILE=
# Optional: push both pages to your own surge.sh domains (needs `npm i -g surge && surge login`).
SURGE_DOMAIN_CYCLES=
SURGE_DOMAIN_CANDLES=
SURGE_DOMAIN_BACKTEST=
